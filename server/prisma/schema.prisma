// Dealer Desk — Prisma schema (MongoDB)
// Converted from MySQL: every id is now a MongoDB ObjectId string instead of
// an autoincrement integer. Foreign-key constraints, cascade deletes, and
// unique constraints are enforced by Prisma's query engine rather than the
// database itself (MongoDB has no native FKs) — see the migration plan for
// what that changes in practice. Field names are still snake_case via @map,
// but the frontend DOES need updating this time: every `id: number` becomes
// `id: string` (see src/api/types.ts).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

// ─────────────────────────────────────────────────────────────────────────
// Auth / Staff / RBAC
// ─────────────────────────────────────────────────────────────────────────

model Staff {
  id           String    @id @default(auto()) @map("_id") @db.ObjectId
  name         String
  email        String    @unique
  passwordHash String    @map("password_hash")
  isActive     Boolean   @default(true) @map("is_active")
  failedLoginCount Int   @default(0) @map("failed_login_count")
  lockedUntil  DateTime? @map("locked_until")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  roles              StaffRole[]
  refreshTokens      RefreshToken[]
  ownedDealers        Dealer[]        @relation("DealerOwner")
  ownedProspects      Prospect[]      @relation("ProspectOwner")
  ownedRequests       Request[]       @relation("RequestOwner")
  ownedVisits         Visit[]         @relation("VisitOwner")
  notifications       Notification[]
  timelineEntries     TimelineEntry[]
  auditLogs           AuditLog[]
  createdProviders    Provider[]
  createdServices     Service[]
  escalationTargetFor EscalationRule[]
  visitAttachments    VisitAttachment[]
  ownedCalendarActivities   CalendarActivity[] @relation("CalendarActivityOwner")
  createdCalendarActivities CalendarActivity[] @relation("CalendarActivityCreator")
  updatedCalendarActivities CalendarActivity[] @relation("CalendarActivityUpdater")
  importedDealerCandidates  DealerImportCandidate[]

  @@map("staff")
}

model Role {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  key         String   @unique
  name        String
  createdAt   DateTime @default(now()) @map("created_at")

  permissions RolePermission[]
  staff       StaffRole[]

  @@map("roles")
}

model Permission {
  id    String @id @default(auto()) @map("_id") @db.ObjectId
  key   String @unique // e.g. "dealers.view", "requests.assign"
  label String

  roles RolePermission[]

  @@map("permissions")
}

model RolePermission {
  id           String @id @default(auto()) @map("_id") @db.ObjectId
  roleId       String @map("role_id") @db.ObjectId
  permissionId String @map("permission_id") @db.ObjectId

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  // MongoDB has no composite primary key — this replaces the old
  // @@id([roleId, permissionId]); Prisma still generates the same
  // `roleId_permissionId` compound-key accessor for `where` clauses.
  @@unique([roleId, permissionId])
  @@map("role_permissions")
}

model StaffRole {
  id      String @id @default(auto()) @map("_id") @db.ObjectId
  staffId String @map("staff_id") @db.ObjectId
  roleId  String @map("role_id") @db.ObjectId

  staff Staff @relation(fields: [staffId], references: [id], onDelete: Cascade)
  role  Role  @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@unique([staffId, roleId])
  @@map("staff_roles")
}

model RefreshToken {
  id           String    @id @default(auto()) @map("_id") @db.ObjectId
  staffId      String?   @map("staff_id") @db.ObjectId
  dealerUserId String?   @map("dealer_user_id") @db.ObjectId
  tokenHash    String    @unique @map("token_hash")
  deviceId     String    @map("device_id")
  platform     String
  appVersion   String    @map("app_version")
  osVersion    String    @map("os_version")
  expiresAt    DateTime  @map("expires_at")
  revokedAt    DateTime? @map("revoked_at")
  replacedBy   String?   @map("replaced_by")
  createdAt    DateTime  @default(now()) @map("created_at")

  staff      Staff?      @relation(fields: [staffId], references: [id], onDelete: Cascade)
  dealerUser DealerUser? @relation(fields: [dealerUserId], references: [id], onDelete: Cascade)

  @@index([staffId])
  @@index([dealerUserId])
  @@map("refresh_tokens")
}

// ─────────────────────────────────────────────────────────────────────────
// Master data / setup (bootstrap payload)
// ─────────────────────────────────────────────────────────────────────────

model Tier {
  id           String  @id @default(auto()) @map("_id") @db.ObjectId
  name         String  @unique
  multiplier   Float // response time multiplier — lower means faster SLA
  priorityBoost Int    @default(0) // levels to reduce effective priority by for dealers in this tier
  rank         Int     @default(0) // display/precedence order in Setup — lower ranks first
  color        String  @default("#6b7280") // used to render Dealer.tier_color; not part of the bootstrap Tier payload

  dealers Dealer[]

  @@map("tiers")
}

model Territory {
  id   String @id @default(auto()) @map("_id") @db.ObjectId
  name String @unique

  dealers Dealer[]

  @@map("territories")
}

model VisitType {
  id   String @id @default(auto()) @map("_id") @db.ObjectId
  name String @unique

  visits Visit[]

  @@map("visit_types")
}

model DocType {
  id   String @id @default(auto()) @map("_id") @db.ObjectId
  name String @unique

  @@map("doc_types")
}

model RequestType {
  id              String   @id @default(auto()) @map("_id") @db.ObjectId
  name            String
  slug            String   @unique
  icon            String
  color           String
  defaultPriority Int      @map("default_priority")
  slaHours        Int      @map("sla_hours")
  pushTarget      String?  @map("push_target")
  allowsProspect  Boolean  @default(false) @map("allows_prospect")
  goesThroughProduction Boolean @default(false) @map("goes_through_production")

  fields          RequestTypeField[]
  requests        Request[]
  escalationRules EscalationRule[]

  @@map("request_types")
}

model RequestTypeField {
  id            String @id @default(auto()) @map("_id") @db.ObjectId
  requestTypeId String @map("request_type_id") @db.ObjectId
  key           String
  label         String
  inputType     String @map("input_type") // text|number|textarea|select|date|toggle|photo|item_ref
  source        String?
  options       Json   @default("[]")
  filter        String?
  isRequired    Boolean @default(false) @map("is_required")
  sortOrder     Int     @default(0) @map("sort_order")
  helpText      String  @default("") @map("help_text")

  requestType RequestType @relation(fields: [requestTypeId], references: [id], onDelete: Cascade)

  @@unique([requestTypeId, key])
  @@map("request_type_fields")
}

/// Configurable status labels, keyed per entity (request, visit, prospect).
model StatusConfig {
  id         String @id @default(auto()) @map("_id") @db.ObjectId
  entityType String @map("entity_type") // "request" | "visit" | "prospect"
  key        String
  label      String
  sortOrder  Int    @default(0) @map("sort_order")

  @@unique([entityType, key])
  @@map("status_config")
}

/// Allowed status transitions per entity type: from -> [to, to, ...]
model StatusTransition {
  id         String @id @default(auto()) @map("_id") @db.ObjectId
  entityType String @map("entity_type")
  fromStatus String @map("from_status")
  toStatus   String @map("to_status")

  @@unique([entityType, fromStatus, toStatus])
  @@map("status_transitions")
}

model AppConfig {
  key   String @id @map("_id")
  value Json

  @@map("app_config")
}

/// Atomic counters for human-readable reference numbers (REQ-000123 etc.)
model Sequence {
  name  String @id @map("_id")
  value Int    @default(0)

  @@map("sequences")
}

// ─────────────────────────────────────────────────────────────────────────
// Dealers
// ─────────────────────────────────────────────────────────────────────────

model Dealer {
  id                 String    @id @default(auto()) @map("_id") @db.ObjectId
  code               String    @unique
  name               String
  displayName        String    @map("display_name")
  tierId             String    @map("tier_id") @db.ObjectId
  territoryId        String    @map("territory_id") @db.ObjectId
  city               String    @default("")
  stateNormalized    String    @default("") @map("state_normalized")
  health             String    @default("good") // good|warning|critical
  healthScore        Int?      @map("health_score")
  phonePrimary       String    @default("") @map("phone_primary")
  whatsappPhone      String    @default("") @map("whatsapp_phone")
  ownerStaffId       String?   @map("owner_staff_id") @db.ObjectId
  clientId           Int?      @map("client_id")
  territoryIsManual  Boolean   @default(false) @map("territory_is_manual")
  lastContactAt      DateTime? @map("last_contact_at")
  createdAt          DateTime  @default(now()) @map("created_at")
  updatedAt          DateTime  @updatedAt @map("updated_at")

  tier      Tier      @relation(fields: [tierId], references: [id])
  territory Territory @relation(fields: [territoryId], references: [id])
  owner     Staff?    @relation("DealerOwner", fields: [ownerStaffId], references: [id])

  contacts          DealerContact[]
  requests          Request[]
  visits            Visit[]
  prospects         Prospect[]         @relation("ConvertedDealer")
  dealerUsers       DealerUser[]
  notifications     Notification[]
  calendarActivities CalendarActivity[]
  importCandidates  DealerImportCandidate[]

  @@index([territoryId])
  @@index([tierId])
  @@index([ownerStaffId])
  @@map("dealers")
}

/// A row parsed from an uploaded dealer list (CSV/Excel), staged here until
/// someone picks it while creating a Dealer — at which point it's marked
/// used and linked to the Dealer it became, so it drops out of future
/// pick-lists without losing the audit trail of where that dealer came from.
model DealerImportCandidate {
  id              String    @id @default(auto()) @map("_id") @db.ObjectId
  name            String
  city            String?
  phonePrimary    String?   @map("phone_primary")
  stateNormalized String?   @map("state_normalized")
  sourceFileName  String?   @map("source_file_name")
  status          String    @default("pending") @map("status") // pending|used
  usedDealerId    String?   @map("used_dealer_id") @db.ObjectId
  createdBy       String?   @map("created_by") @db.ObjectId
  createdAt       DateTime  @default(now()) @map("created_at")
  usedAt          DateTime? @map("used_at")

  usedDealer Dealer? @relation(fields: [usedDealerId], references: [id])
  creator    Staff?  @relation(fields: [createdBy], references: [id])

  @@index([status])
  @@map("dealer_import_candidates")
}

model DealerContact {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  dealerId  String   @map("dealer_id") @db.ObjectId
  name      String
  roleLabel String   @default("") @map("role_label")
  phone     String   @default("")
  email     String   @default("")
  isPrimary Boolean  @default(false) @map("is_primary")
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")

  dealer Dealer @relation(fields: [dealerId], references: [id], onDelete: Cascade)

  @@index([dealerId])
  @@map("dealer_contacts")
}

// ─────────────────────────────────────────────────────────────────────────
// Prospects
// ─────────────────────────────────────────────────────────────────────────

model Prospect {
  id                String    @id @default(auto()) @map("_id") @db.ObjectId
  refNo             String    @unique @map("ref_no")
  companyName       String    @map("company_name")
  contactName       String    @default("") @map("contact_name")
  email             String    @default("")
  phone             String    @default("")
  whatsapp          String    @default("")
  city              String    @default("")
  stateNormalized   String    @default("") @map("state_normalized")
  stage             String    @default("new")
  stageChangedAt    DateTime  @default(now()) @map("stage_changed_at")
  ownerStaffId      String    @map("owner_staff_id") @db.ObjectId
  source            String    @default("")
  convertedDealerId String?   @unique @map("converted_dealer_id") @db.ObjectId
  createdAt         DateTime  @default(now()) @map("created_at")

  owner          Staff      @relation("ProspectOwner", fields: [ownerStaffId], references: [id])
  convertedDealer Dealer?   @relation("ConvertedDealer", fields: [convertedDealerId], references: [id])

  onboardingItems OnboardingItem[]
  visits          Visit[]
  requests        Request[]

  @@index([ownerStaffId])
  @@index([stage])
  @@map("prospects")
}

model OnboardingItem {
  id         String  @id @default(auto()) @map("_id") @db.ObjectId
  prospectId String  @map("prospect_id") @db.ObjectId
  docName    String  @map("doc_name")
  isRequired Boolean @default(true) @map("is_required")
  status     String  @default("pending") // pending|received|verified|rejected

  prospect Prospect @relation(fields: [prospectId], references: [id], onDelete: Cascade)

  // Without this, seed.ts's `skipDuplicates: true` has no unique index to
  // detect a duplicate against, so re-running the seed silently inserts a
  // fresh duplicate batch every time instead of skipping.
  @@unique([prospectId, docName])
  @@map("onboarding_items")
}

// ─────────────────────────────────────────────────────────────────────────
// Requests
// ─────────────────────────────────────────────────────────────────────────

model Request {
  id                  String    @id @default(auto()) @map("_id") @db.ObjectId
  refNo               String    @unique @map("ref_no")
  title               String
  description         String?
  typeId              String    @map("type_id") @db.ObjectId
  status              String    @default("new")
  priority            Int       @default(3)
  priorityOverride    Int?      @map("priority_override")
  priorityReason      String?   @map("priority_reason")
  dealerId            String?   @map("dealer_id") @db.ObjectId
  prospectId          String?   @map("prospect_id") @db.ObjectId
  ownerStaffId        String?   @map("owner_staff_id") @db.ObjectId
  dueAt               DateTime? @map("due_at")
  scheduledAt         DateTime? @map("scheduled_at")
  completionRequired  Int       @default(0) @map("completion_required")
  completionDone      Int       @default(0) @map("completion_done")
  closedReason        String?   @map("closed_reason")
  doneAt              DateTime? @map("done_at")
  erpExternalRef      String?   @map("erp_external_ref")
  erpSyncStatus       String?   @map("erp_sync_status") // pending|pushed|failed
  clientUuid          String?   @unique @map("client_uuid") // idempotency key
  createdAt           DateTime  @default(now()) @map("created_at")
  updatedAt           DateTime  @updatedAt @map("updated_at")

  type     RequestType @relation(fields: [typeId], references: [id])
  dealer   Dealer?     @relation(fields: [dealerId], references: [id])
  prospect Prospect?   @relation(fields: [prospectId], references: [id])
  owner    Staff?      @relation("RequestOwner", fields: [ownerStaffId], references: [id])

  fields          RequestFieldValue[]
  lines           RequestLine[]
  escalationLogs  EscalationLog[]

  @@index([dealerId])
  @@index([prospectId])
  @@index([ownerStaffId])
  @@index([status])
  @@index([priority])
  @@index([dueAt])
  @@index([scheduledAt])
  @@map("requests")
}

model RequestFieldValue {
  id         String @id @default(auto()) @map("_id") @db.ObjectId
  requestId  String @map("request_id") @db.ObjectId
  groupIndex Int    @default(0) @map("group_index") // lets one request carry multiple repeated field groups (e.g. several vehicles on one warranty claim)
  key        String
  value      String

  request Request @relation(fields: [requestId], references: [id], onDelete: Cascade)

  @@unique([requestId, key, groupIndex])
  @@map("request_field_values")
}

model RequestLine {
  id          String  @id @default(auto()) @map("_id") @db.ObjectId
  requestId   String  @map("request_id") @db.ObjectId
  description String
  qty         Float   @default(1)
  unitRate    Float?  @map("unit_rate")
  total       Float?

  request Request @relation(fields: [requestId], references: [id], onDelete: Cascade)

  @@index([requestId])
  @@map("request_lines")
}

// ─────────────────────────────────────────────────────────────────────────
// Visits
// ─────────────────────────────────────────────────────────────────────────

model Visit {
  id           String    @id @default(auto()) @map("_id") @db.ObjectId
  refNo        String    @unique @map("ref_no")
  dealerId     String?   @map("dealer_id") @db.ObjectId
  prospectId   String?   @map("prospect_id") @db.ObjectId
  visitTypeId  String    @map("visit_type_id") @db.ObjectId
  title        String    @default("")
  scheduledAt  DateTime  @map("scheduled_at")
  startAt      DateTime? @map("start_at")
  endAt        DateTime? @map("end_at")
  status       String    @default("scheduled") // scheduled|in_progress|done|cancelled
  outcome      String?
  outcomeNote  String?   @map("outcome_note")
  nextStep     String?   @map("next_step")
  nextAt       DateTime? @map("next_at")
  ownerStaffId String    @map("owner_staff_id") @db.ObjectId
  agendaJson   Json?     @map("agenda_json")
  clientUuid   String?   @unique @map("client_uuid")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  dealer      Dealer?           @relation(fields: [dealerId], references: [id])
  prospect    Prospect?         @relation(fields: [prospectId], references: [id])
  visitType   VisitType         @relation(fields: [visitTypeId], references: [id])
  owner       Staff             @relation("VisitOwner", fields: [ownerStaffId], references: [id])
  attachments VisitAttachment[]

  @@index([dealerId])
  @@index([prospectId])
  @@index([ownerStaffId])
  @@index([scheduledAt])
  @@index([status])
  @@map("visits")
}

model VisitAttachment {
  id                String   @id @default(auto()) @map("_id") @db.ObjectId
  visitId           String   @map("visit_id") @db.ObjectId
  fileName          String   @map("file_name")
  storedName        String   @map("stored_name")
  mimeType          String   @map("mime_type")
  sizeBytes         Int      @map("size_bytes")
  uploadedByStaffId String   @map("uploaded_by_staff_id") @db.ObjectId
  createdAt         DateTime @default(now()) @map("created_at")

  visit      Visit @relation(fields: [visitId], references: [id], onDelete: Cascade)
  uploadedBy Staff @relation(fields: [uploadedByStaffId], references: [id])

  @@index([visitId])
  @@map("visit_attachments")
}

// ─────────────────────────────────────────────────────────────────────────
// Calendar activities — user-created tasks/reminders/meetings/follow-ups/
// callbacks. Requests and Visits already carry their own scheduled_at/due_at
// and appear on the calendar directly from their own tables (see
// server/src/modules/calendar) — this model is only for activities that
// don't already exist as some other domain object.
// ─────────────────────────────────────────────────────────────────────────

model CalendarActivity {
  id              String    @id @default(auto()) @map("_id") @db.ObjectId
  title           String
  description     String?
  type            String    // task|reminder|meeting|followup|callback|sales_activity|payment_followup|delivery|service_followup
  startAt         DateTime  @map("start_at")
  endAt           DateTime  @map("end_at")
  timezone        String    @default("Asia/Kolkata")
  reminderMinutes Int?      @map("reminder_minutes")
  dealerId        String?   @map("dealer_id") @db.ObjectId
  ownerStaffId    String    @map("owner_staff_id") @db.ObjectId
  priority        Int       @default(3)
  status          String    @default("scheduled") // scheduled|completed|cancelled
  completedAt     DateTime? @map("completed_at")
  createdBy       String    @map("created_by") @db.ObjectId
  updatedBy       String?   @map("updated_by") @db.ObjectId
  clientUuid      String?   @unique @map("client_uuid")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  dealer  Dealer? @relation(fields: [dealerId], references: [id])
  owner   Staff   @relation("CalendarActivityOwner", fields: [ownerStaffId], references: [id])
  creator Staff   @relation("CalendarActivityCreator", fields: [createdBy], references: [id])
  updater Staff?  @relation("CalendarActivityUpdater", fields: [updatedBy], references: [id])

  @@index([ownerStaffId])
  @@index([dealerId])
  @@index([startAt])
  @@index([status])
  @@map("calendar_activities")
}

// ─────────────────────────────────────────────────────────────────────────
// Escalation rules
// ─────────────────────────────────────────────────────────────────────────

model EscalationRule {
  id       String  @id @default(auto()) @map("_id") @db.ObjectId
  name     String
  isActive Boolean @default(true) @map("is_active")

  triggerPriority      Int?    @map("trigger_priority") // null = any priority
  triggerRequestTypeId String? @map("trigger_request_type_id") @db.ObjectId // null = any type
  triggerHoursOverdue  Int     @map("trigger_hours_overdue") // 0 = the moment it breaches SLA

  actionType          String  @map("action_type") // notify_owner | notify_role | reassign
  actionTargetStaffId String? @map("action_target_staff_id") @db.ObjectId // used by reassign
  actionTargetRole    String? @map("action_target_role") // used by notify_role (Role.key)

  /// Template placeholders: {ref_no} {dealer_name} {hours_overdue} {title}
  escalationMessage String @map("escalation_message")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  requestType RequestType? @relation(fields: [triggerRequestTypeId], references: [id])
  targetStaff Staff?       @relation(fields: [actionTargetStaffId], references: [id])
  logs        EscalationLog[]

  @@index([isActive])
  @@map("escalation_rules")
}

model EscalationLog {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  ruleId      String   @map("rule_id") @db.ObjectId
  requestId   String   @map("request_id") @db.ObjectId
  actionTaken String   @map("action_taken")
  firedAt     DateTime @default(now()) @map("fired_at")

  rule    EscalationRule @relation(fields: [ruleId], references: [id], onDelete: Cascade)
  request Request        @relation(fields: [requestId], references: [id], onDelete: Cascade)

  @@unique([ruleId, requestId])
  @@index([requestId])
  @@map("escalation_logs")
}

// ─────────────────────────────────────────────────────────────────────────
// Cross-cutting: timeline, notifications, audit, sync
// ─────────────────────────────────────────────────────────────────────────

model TimelineEntry {
  id           String   @id @default(auto()) @map("_id") @db.ObjectId
  entityType   String   @map("entity_type") // dealer|prospect|request|visit
  // Loose polymorphic reference (not a Prisma @relation — entityType decides
  // which collection entityId points into), so it's a plain String, not
  // @db.ObjectId; it still holds the same ObjectId-shaped strings.
  entityId     String   @map("entity_id")
  eventType    String   @map("event_type")
  summary      String
  actorStaffId String?  @map("actor_staff_id") @db.ObjectId
  createdAt    DateTime @default(now()) @map("created_at")

  actor Staff? @relation(fields: [actorStaffId], references: [id])

  @@index([entityType, entityId])
  @@map("timeline_entries")
}

model Notification {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  // Exactly one of staffId / dealerId is set, enforced in application code —
  // staff and dealer-portal notifications are otherwise unrelated audiences.
  staffId   String?  @map("staff_id") @db.ObjectId
  dealerId  String?  @map("dealer_id") @db.ObjectId
  title     String
  body      String
  message   String
  linkUrl   String?  @map("link_url")
  isRead    Boolean  @default(false) @map("is_read")
  createdAt DateTime @default(now()) @map("created_at")

  staff  Staff?  @relation(fields: [staffId], references: [id], onDelete: Cascade)
  dealer Dealer? @relation(fields: [dealerId], references: [id], onDelete: Cascade)

  @@index([staffId, isRead])
  @@index([dealerId, isRead])
  @@map("notifications")
}

model AuditLog {
  id           String   @id @default(auto()) @map("_id") @db.ObjectId
  actorStaffId String?  @map("actor_staff_id") @db.ObjectId
  action       String
  entityType   String   @map("entity_type")
  // Loose polymorphic reference, same reasoning as TimelineEntry.entityId.
  entityId     String?  @map("entity_id")
  beforeJson   Json?    @map("before_json")
  afterJson    Json?    @map("after_json")
  ip           String?
  userAgent    String?  @map("user_agent")
  requestId    String?  @map("request_id")
  createdAt    DateTime @default(now()) @map("created_at")

  actor Staff? @relation(fields: [actorStaffId], references: [id])

  @@index([entityType, entityId])
  @@index([actorStaffId])
  @@map("audit_logs")
}

/// One-time password for the forgot-password flow. Keyed by email rather
/// than a FK to Staff/DealerUser because we don't know which table the
/// account lives in until reset time (same "try dealer, then staff" lookup
/// order as login) — see authService.requestPasswordReset/resetPassword.
model PasswordResetOtp {
  id         String    @id @default(auto()) @map("_id") @db.ObjectId
  email      String
  otpHash    String    @map("otp_hash")
  attempts   Int       @default(0)
  expiresAt  DateTime  @map("expires_at")
  consumedAt DateTime? @map("consumed_at")
  createdAt  DateTime  @default(now()) @map("created_at")

  @@index([email])
  @@map("password_reset_otps")
}

// ─────────────────────────────────────────────────────────────────────────
// Dealer portal login
// ─────────────────────────────────────────────────────────────────────────

model DealerUser {
  id               String    @id @default(auto()) @map("_id") @db.ObjectId
  email            String    @unique
  passwordHash     String    @map("password_hash")
  dealerId         String    @map("dealer_id") @db.ObjectId
  name             String
  isActive         Boolean   @default(true) @map("is_active")
  failedLoginCount Int       @default(0) @map("failed_login_count")
  lockedUntil      DateTime? @map("locked_until")
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @updatedAt @map("updated_at")

  dealer        Dealer         @relation(fields: [dealerId], references: [id], onDelete: Cascade)
  refreshTokens RefreshToken[]

  @@index([dealerId])
  @@map("dealer_users")
}

// ─────────────────────────────────────────────────────────────────────────
// Services / Providers catalog
// ─────────────────────────────────────────────────────────────────────────

model Provider {
  id                 String   @id @default(auto()) @map("_id") @db.ObjectId
  providerCode       String   @unique @map("provider_code")
  name               String
  slug               String   @unique
  logo               String?
  coverImage         String?  @map("cover_image")
  shortDescription   String?  @map("short_description")
  description        String?
  contactPhone       String?  @map("contact_phone")
  contactEmail       String?  @map("contact_email")
  contactWebsite     String?  @map("contact_website")
  addressCountry     String?  @map("address_country")
  addressState       String?  @map("address_state")
  addressCity        String?  @map("address_city")
  addressLine        String?  @map("address_line")
  addressPostalCode  String?  @map("address_postal_code")
  categories         Json     @default("[]")
  verificationStatus String   @default("pending") @map("verification_status") // pending|verified|rejected|inactive
  status             String   @default("active") // active|inactive
  serviceCount       Int      @default(0) @map("service_count")
  rating             Float?
  reviewCount        Int      @default(0) @map("review_count")
  createdBy          String?  @map("created_by") @db.ObjectId
  createdAt          DateTime @default(now()) @map("created_at")
  updatedAt          DateTime @updatedAt @map("updated_at")

  creator  Staff?    @relation(fields: [createdBy], references: [id])
  services Service[]

  @@index([status])
  @@index([verificationStatus])
  @@map("providers")
}

model ServiceCategory {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  name        String   @unique
  slug        String   @unique
  description String?
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  services Service[]

  @@map("service_categories")
}

model Service {
  id                  String   @id @default(auto()) @map("_id") @db.ObjectId
  serviceCode         String   @unique @map("service_code")
  name                String
  slug                String   @unique
  categoryId          String?  @map("category_id") @db.ObjectId
  shortDescription    String?  @map("short_description")
  description         String?
  images              Json     @default("[]")
  providerId          String?  @map("provider_id") @db.ObjectId
  serviceType         String?  @map("service_type")
  pricingType         String?  @map("pricing_type") // free|fixed|range|quote
  pricingAmount       Float?   @map("pricing_amount")
  pricingMinAmount    Float?   @map("pricing_min_amount")
  pricingMaxAmount    Float?   @map("pricing_max_amount")
  pricingCurrency     String?  @map("pricing_currency")
  durationValue       Float?   @map("duration_value")
  durationUnit        String?  @map("duration_unit") // minutes|hours|days
  locationCountry     String?  @map("location_country")
  locationState       String?  @map("location_state")
  locationCity        String?  @map("location_city")
  locationAddress     String?  @map("location_address")
  availabilityEnabled Boolean  @default(true) @map("availability_enabled")
  availabilityDays    Json     @default("[]") @map("availability_days")
  availabilityStart   String?  @map("availability_start")
  availabilityEnd     String?  @map("availability_end")
  eligibility         Json     @default("[]")
  requiredDocuments   Json     @default("[]") @map("required_documents")
  features            Json     @default("[]")
  termsAndConditions  String?  @map("terms_and_conditions")
  status              String   @default("draft") // draft|active|inactive|archived
  isFeatured          Boolean  @default(false) @map("is_featured")
  createdBy           String?  @map("created_by") @db.ObjectId
  createdAt           DateTime @default(now()) @map("created_at")
  updatedAt           DateTime @updatedAt @map("updated_at")

  provider Provider?        @relation(fields: [providerId], references: [id])
  creator  Staff?           @relation(fields: [createdBy], references: [id])
  category ServiceCategory? @relation(fields: [categoryId], references: [id])

  @@index([status])
  @@index([providerId])
  @@index([categoryId])
  @@map("services")
}

/// Records every mutation UUID applied via /sync/batch so repeats are no-ops.
model SyncMutation {
  clientUuid String   @id @map("_id")
  staffId    String   @map("staff_id") @db.ObjectId
  opType     String   @map("op_type")
  entityType String   @map("entity_type")
  entityId   String?  @map("entity_id")
  status     String   @default("applied") // applied|failed
  error      String?
  appliedAt  DateTime @default(now()) @map("applied_at")

  @@map("sync_mutations")
}
