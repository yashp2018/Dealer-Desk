# ── Server ───────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=4000
API_PREFIX=/api/v1

# ── Database (MySQL) ─────────────────────────────────────────────────────
# mysql://USER:PASSWORD@HOST:PORT/DATABASE
# Use 127.0.0.1, not localhost — on Windows, Node resolves "localhost" to the
# IPv6 loopback (::1) first and never falls back to IPv4, so if mysqld's IPv6
# listener is ever unreachable (a common local Windows networking hiccup),
# every connection attempt fails with P1001 even though the server is up and
# answering fine on IPv4. 127.0.0.1 sidesteps DNS/resolution entirely.
DATABASE_URL="mysql://dealerdesk:dealerdesk@127.0.0.1:3306/dealer_desk"

# ── Auth ─────────────────────────────────────────────────────────────────
JWT_ACCESS_SECRET=change-me-to-a-long-random-string
JWT_REFRESH_SECRET=change-me-to-a-different-long-random-string
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d
BCRYPT_SALT_ROUNDS=12
MAX_FAILED_LOGIN_ATTEMPTS=5
ACCOUNT_LOCK_MINUTES=15

# ── CORS ─────────────────────────────────────────────────────────────────
CORS_ORIGIN=http://localhost:5173

# ── Logging ──────────────────────────────────────────────────────────────
LOG_LEVEL=info

# ── Uploads ──────────────────────────────────────────────────────────────
UPLOAD_MAX_SIZE_MB=10
UPLOAD_DIR=uploads

# ── Rate limiting ────────────────────────────────────────────────────────
RATE_LIMIT_WINDOW_MINUTES=15
RATE_LIMIT_MAX=300

# ── ERP integration (optional — leave blank to run with ERP push disabled) ─
ERP_BASE_URL=
ERP_API_KEY=

# ── Bootstrap config values ──────────────────────────────────────────────
VOICE_MAX_SECONDS=120
RECENT_DEALERS_COUNT=10
SYNC_BATCH_MAX=50
REF_BLOCK_SIZE=20
SLA_CLOCK=business_hours

# ── Google Sign-In (optional) ────────────────────────────────────────────
# Leave blank to keep /auth/google disabled (returns a clear error instead
# of crashing). Create at console.cloud.google.com/apis/credentials — OAuth
# client ID, type "Web application". Must be the SAME Client ID as the
# frontend's VITE_GOOGLE_CLIENT_ID.
GOOGLE_CLIENT_ID=

# ── Password reset OTP ───────────────────────────────────────────────────
# 'console' logs the code to this server's terminal instead of emailing it —
# there is no real email provider wired up yet (see src/common/utils/mailer.ts).
# Switch to 'email' only after implementing real delivery there.
OTP_DELIVERY=console
OTP_EXPIRES_MINUTES=10
OTP_MAX_ATTEMPTS=5
