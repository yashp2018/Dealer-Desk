# ── Server ───────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=4000
API_PREFIX=/api/v1

# ── Database (MySQL) ─────────────────────────────────────────────────────
# mysql://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL="mysql://dealerdesk:dealerdesk@localhost:3306/dealer_desk"

# ── Auth ─────────────────────────────────────────────────────────────────
JWT_ACCESS_SECRET=change-me-to-a-long-random-string
JWT_REFRESH_SECRET=change-me-to-a-different-long-random-string
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d
BCRYPT_SALT_ROUNDS=12
MAX_FAILED_LOGIN_ATTEMPTS=5
ACCOUNT_LOCK_MINUTES=15

# ── CORS ─────────────────────────────────────────────────────────────────
CORS_ORIGIN=http://localhost:5173

# ── Logging ──────────────────────────────────────────────────────────────
LOG_LEVEL=info

# ── Uploads ──────────────────────────────────────────────────────────────
UPLOAD_MAX_SIZE_MB=10
UPLOAD_DIR=uploads

# ── Rate limiting ────────────────────────────────────────────────────────
RATE_LIMIT_WINDOW_MINUTES=15
RATE_LIMIT_MAX=300

# ── ERP integration (optional — leave blank to run with ERP push disabled) ─
ERP_BASE_URL=
ERP_API_KEY=

# ── Bootstrap config values ──────────────────────────────────────────────
VOICE_MAX_SECONDS=120
RECENT_DEALERS_COUNT=10
SYNC_BATCH_MAX=50
REF_BLOCK_SIZE=20
SLA_CLOCK=business_hours
