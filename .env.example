# Points to the Express server via Vite dev proxy (no rewrite needed)
# For production, set this to the full backend URL e.g. https://api.yourapp.com/api/v1
VITE_API_BASE_URL=/api/v1

# "Sign in with Google" on the login page. Leave blank to keep the button
# hidden. Create one at https://console.cloud.google.com/apis/credentials —
# OAuth client ID, type "Web application", authorized JavaScript origin
# matching this frontend's URL (e.g. http://localhost:5173 for dev).
# Must match server/.env's GOOGLE_CLIENT_ID exactly (same Client ID both sides).
VITE_GOOGLE_CLIENT_ID=
